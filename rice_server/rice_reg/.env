# ===== 服务配置 =====
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=7000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=7001
BACKEND_API_URL=http://127.0.0.1:7001

# ===== Python 解释器 =====
BACKEND_PYTHON_BIN=/root/miniconda3/envs/vllm/bin/python
FRONTEND_PYTHON_BIN=/root/miniconda3/envs/rice_reg/bin/python
# BACKEND_PYTHON_BIN=python
# FRONTEND_PYTHON_BIN=python

# ===== 模型路径 =====
BASE_MODEL_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/rice_1B_32k_hf
CHECKPOINT_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/three_sam2.model.safetensors

# ===== 机器配置(GPU) =====
# CUDA_VISIBLE_DEVICES: 限制进程可见的 GPU 编号(经 run_backend.sh 导出, PyTorch 自动生效)
CUDA_VISIBLE_DEVICES=0
# DEVICE: 模型加载/推理设备, 如 cuda:0 / cuda:1 / cpu; 留空则自动选择 cuda/cpu
DEVICE=cuda:0

# ===== 推理参数 =====
PREDICTOR_TYPE=fusion
DATASET_TYPE=v0
ATAC_ENCODER_OUTPUT_DIM=1024
TARGET_LEN=32678
OVERLAP_LEN=16000
FIXED_TRACK_MEAN_PLUS=2.83
FIXED_TRACK_MEAN_MINUS=2.85
MODEL_TORCH_DTYPE=bfloat16
# 单次模型前向处理的窗口数(并发下 GPU 仍由 _infer_lock 串行)
INFERENCE_BATCH_SIZE=8

# ===== 基因组配置 =====
# 格式: GENOME_<ID>_FASTA, GENOME_<ID>_FAI, GENOME_<ID>_GFF
GENOME_MH63_FASTA=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/genome/MH63RS2.fa
GENOME_MH63_FAI=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/genome/MH63RS2.fa.fai
GENOME_MH63_GFF=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/genome/MH63RS2.gff3
GENOME_NIP_FASTA=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/genome/NIP-T2T.fa
GENOME_NIP_FAI=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/genome/NIP-T2T.fa.fai
GENOME_NIP_GFF=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/genome/NIP-T2T.gff3

# ===== 内置 ATAC 路径 =====
# 格式: ATAC_PATH_<ID>
ATAC_PATH_SAM2_MH63_1=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/ATAC/ATAC_SAM2_MH63_1.MH63RS2.q30.bin5.CPM.bw
ATAC_PATH_SAM2_NIP_1=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/ATAC/ATAC_SAM2_NIP_1.NIP.q30.bin5.CPM.bw

# ===== ATAC → Genome 映射 =====
# 格式: ATAC_GENOME_MAP_<GENOME>=<ATAC_ID1>,<ATAC_ID2>
ATAC_GENOME_MAP_MH63=SAM2_MH63_1
ATAC_GENOME_MAP_NIP=SAM2_NIP_1

# ===== 缓存目录 =====
BACKEND_UPLOADED_ATAC=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/rice_reg/cache/uploaded_atac
BACKEND_UPLOADED_GENOMES=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/rice_reg/cache/uploaded_genomes
BACKEND_PREDICTION_CACHE=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/rice_reg/cache/predictions

# ===== 上传基因组 TTL 清理 =====
# 超过该时长(小时)未使用的上传 custom genome 会被自动清理(FASTA + .fai + GFF)
UPLOADED_GENOMES_TTL_HOURS=0.5
# 清理线程扫描间隔(秒)
UPLOADED_GENOMES_CLEANUP_INTERVAL=300

# ===== 上传大小限制(单位 MB)=====
MAX_UPLOAD_MB=640            # 自定义基因组 FASTA / GFF
MAX_ATAC_UPLOAD_MB=200     # ATAC bigWig(默认 200M)
