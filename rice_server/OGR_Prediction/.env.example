# ===== 服务配置 =====
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
BACKEND_API_URL=http://127.0.0.1:8001

# ===== 上传大小限制(单位 MB, 默认 640) =====
MAX_UPLOAD_MB=640

# ===== Python 解释器 =====
BACKEND_PYTHON_BIN=/path/to/your/python
FRONTEND_PYTHON_BIN=/path/to/your/python

# ===== 模型路径 =====
BASE_MODEL_PATH=/path/to/rice_1B_stage2_8k_hf
CHECKPOINT_PATH=/path/to/checkpoint-23540/model.safetensors
INDEX_STAT_PATH=/path/to/index_stat3.json

# ===== 推理参数 =====
USE_FLASH_ATTN=true
MODEL_TORCH_DTYPE=bfloat16
DEVICE=cuda:0
# 单次模型前向处理的序列数(当前 API 单窗口请求, 保持 1; 预留批量推理)
INFERENCE_BATCH_SIZE=1
PROJ_DIM=1024
NUM_DOWNSAMPLES=4
BOTTLENECK_DIM=1536
MAX_SEQ_LEN=32768

# ===== 基因组配置 =====
# 格式: GENOME_<ID>_FASTA, GENOME_<ID>_FAI, GENOME_<ID>_GFF
# GENOME_osa1_r7_FASTA=/path/to/osa1_r7.asm.ch.fa
# GENOME_osa1_r7_FAI=/path/to/osa1_r7.asm.ch.fa.fai
# GENOME_osa1_r7_GFF=/path/to/modified_osa1_r7.all_models.gff3

# ===== 缓存模式 =====
# CACHE_MODE 只控制【懒加载 + 内容寻址缓存】:
# true  = 启用内容寻址预测缓存(相同窗口复用上次结果,跳过 GPU 推理) + 上传文件复制到 cache 目录
# false = 懒加载部署:不做内容寻址缓存(每次请求重跑推理) + 自定义基因组只按本机路径注册(零拷贝)
# 两种模式下预测中间 bigWig 一律写入 BACKEND_PREDICTION_CACHE,服务重启时自动清空该目录。
CACHE_MODE=true

# ===== 缓存目录 =====
# 注意:请使用绝对路径(静态文件服务按绝对路径解析)
BACKEND_UPLOADED_FASTA=/abs/path/to/OGR/OGR_Prediction/uploaded_fasta
# 上传基因组副本 / 外部 FASTA 的 .fai 软链接落盘位置
BACKEND_UPLOADED_GENOMES=/abs/path/to/OGR/OGR_Prediction/uploaded_genomes
# 预测中间 bigWig 目录(两种模式都用它;服务重启时整个目录被清空重建)
BACKEND_PREDICTION_CACHE=/abs/path/to/OGR/OGR_Prediction/predictions
# 后台清理陈旧 bigWig 的扫描间隔(秒)与存活时长(秒)
PREDICTION_CACHE_CLEANUP_INTERVAL=600
PREDICTION_CACHE_TTL_SECONDS=1800

# ===== 上传基因组 TTL 清理 =====
# 超过该时长(小时)未使用的上传 custom genome 会被自动清理(FASTA + .fai + GFF)
UPLOADED_GENOMES_TTL_HOURS=0.5
# 清理线程扫描间隔(秒)
UPLOADED_GENOMES_CLEANUP_INTERVAL=300
