# ===== 服务配置 =====
HOST=0.0.0.0
PORT=8000

# ===== 设备配置 =====
# DEVICE: 单设备 cuda:0 / npu:0 / cpu; 多设备逗号分隔如 cuda:0,cuda:1; 留空自动检测(NPU > CUDA > CPU)
DEVICE=
# 多设备时使用的 device_map: auto / balanced / sequential / 留空
DEVICE_MAP=
# 内存分配比例(0.0-1.0)
MEMORY_RATIO=0.9
# 强制 CPU 推理(true/false)
FORCE_CPU=false

# ===== 模型注册表 =====
# 每个模型可配置以下项(NAME 即 API 中 model_name):
#   MODEL_<NAME>_PATH      模型目录路径(必填; 不填则回退 {prefix}/Genos-<NAME> 旧逻辑)
#   MODEL_<NAME>_TYPE      flash | no_flash (可选, 默认 flash)
#   MODEL_<NAME>_MAX_LEN   最大序列长度, 超出截断(可选, 默认不截断)
#   MODEL_<NAME>_SPECIAL   是否添加特殊token: 1/0 (可选, 默认由tokenizer决定)

# ---- 水稻 1B 基模 (rice_mut: stage2 8k) ----
MODEL_1B_8k_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_mut/rice_1B_stage2_8k_hf
MODEL_1B_8k_TYPE=flash
MODEL_1B_8k_MAX_LEN=32768
MODEL_1B_8k_SPECIAL=0

# ---- 水稻 1B 基模 (rice_reg: 32k) ----
# 注: 两基模 tokenizer 均为单碱基编码且默认不加特殊token, SPECIAL 统一 0
MODEL_1B_32k_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/rice_reg/rice_1B_32k_hf
MODEL_1B_32k_TYPE=flash
MODEL_1B_32k_MAX_LEN=32678
MODEL_1B_32k_SPECIAL=0

# ---- Genos 大模型 (可选; DCS 容器内路径示例) ----
# MODEL_1.2B_PATH=/AI_models/BGI-HangzhouAI/Genos-1.2B
# MODEL_1.2B_TYPE=flash
# MODEL_10B_PATH=/AI_models/BGI-HangzhouAI/Genos-10B
# MODEL_10B_TYPE=flash

# ===== DCS 适配层 (dcs_adapter.py) =====
# 监听端口: 优先级 PORT > BACKEND_PORT > 8001(与 rice_mut 的 dcs_adapter 一致)
# 注意: Sanic 原服务(dna_embedding.py)默认 8000, 适配层默认 8001, 避免端口冲突
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001

# API Key 鉴权(可选): 配置后 POST 需带 Authorization: Bearer <key> / X-API-Key: <key>
# 留空 = 不启用鉴权(本地直连/开发测试)
DCS_API_KEY=

# 计费口径: prompt_tokens = 输入 token 数 × 系数; completion_tokens = 输出元素数 × 系数
DCS_PROMPT_TOKEN_MULTIPLIER=1
DCS_COMPLETION_TOKEN_MULTIPLIER=1
