# ============================================================
# dcs_gateway 配置 —— 本文件优先级最高
#
# 端口 / Python 解释器解析顺序（从高到低）:
#   1) 本 .env（端口 + RICE_*_PYTHON）          ← 最高
#   2) 启动时的 shell 环境变量（RICE_*_PORT / GATEWAY_PORT 等）
#   3) 各服务 .env 的 BACKEND_PYTHON_BIN（仅解释器回退）
#   4) 脚本/代码内置默认值
# ============================================================

# ---- 三个后端地址（同机部署默认 127.0.0.1；跨机部署改 IP/服务名） ----
RICE_MUT_HOST=127.0.0.1
RICE_MUT_PORT=8001
RICE_REG_HOST=127.0.0.1
RICE_REG_PORT=7001
RICE_OGR_HOST=127.0.0.1
# rice_OGR 与 rice_mut 错开（本地可用 6001/8003 等任意空闲端口）
RICE_OGR_PORT=6001

# ---- 各后端 Python 解释器（.env 优先；留空则自动回退） ----
# 回退链: 本变量 > shell 环境变量 > 各服务 .env 的 BACKEND_PYTHON_BIN > vllm 环境 > python
# RICE_MUT_PYTHON=/root/miniconda3/envs/vllm/bin/python
# RICE_REG_PYTHON=/root/miniconda3/envs/vllm/bin/python
# RICE_OGR_PYTHON=/root/miniconda3/envs/vllm/bin/python
RICE_MUT_PYTHON=python
RICE_REG_PYTHON=python
RICE_OGR_PYTHON=python

# ---- 网关自身监听 ----
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=9000
# DCS 平台部署时若注入 PORT，则 PORT 优先于 GATEWAY_PORT（app.py 逻辑）