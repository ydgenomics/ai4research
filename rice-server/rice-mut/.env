# ===== 服务配置 =====
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
BACKEND_API_URL=http://127.0.0.1:8001

# ===== 上传大小限制(单位 MB) =====
MAX_UPLOAD_MB=640

# ===== Python 解释器 =====
BACKEND_PYTHON_BIN=/root/miniconda3/envs/vllm/bin/python
FRONTEND_PYTHON_BIN=/root/miniconda3/envs/rice_reg/bin/python

# ===== 模型路径 =====
BASE_MODEL_PATH=/mnt/rice/default/Workspace/yangdong/rice_reg/rice-server/source/rice-mut/rice_1B_stage2_8k_hf
CHECKPOINT_PATH=/mnt/rice/default/Workspace/yangdong/rice_reg/rice-server/source/rice-mut/csq-5_model.safetensors
INDEX_STAT_PATH=/mnt/rice/default/Workspace/yangdong/rice_reg/rice-server/source/rice-mut/index_stat.json

# ===== 推理参数 =====
USE_FLASH_ATTN=true
MODEL_TORCH_DTYPE=bfloat16
DEVICE=cuda:0
# 单次模型前向处理的序列数
INFERENCE_BATCH_SIZE=4
PROJ_DIM=1024
NUM_DOWNSAMPLES=4
BOTTLENECK_DIM=1536
MAX_SEQ_LEN=32768

# ===== 基因组配置 =====
# 格式: GENOME_<ID>_FASTA, GENOME_<ID>_FAI, GENOME_<ID>_GFF
GENOME_osa1_r7_FASTA=/mnt/rice/default/Workspace/yangdong/rice_reg/rice-server/source/rice-mut/osa1_r7.asm.ch.fa
GENOME_osa1_r7_FAI=/mnt/rice/default/Workspace/yangdong/rice_reg/rice-server/source/rice-mut/osa1_r7.asm.ch.fa.fai
GENOME_osa1_r7_GFF=/mnt/rice/default/Workspace/yangdong/rice_reg/rice-server/source/rice-mut/osa1_r7.all_models.gff3

# ===== 缓存目录 =====
BACKEND_UPLOADED_FASTA=/mnt/rice/default/Workspace/yangdong/rice_reg/rice-mutation/cache/uploaded_fasta
BACKEND_PREDICTION_CACHE=/mnt/rice/default/Workspace/yangdong/rice_reg/rice-mutation/cache/predictions

# ===== 上传基因组 TTL 清理 =====
# 超过该时长(小时)未使用的上传 custom genome 会被自动清理(FASTA + .fai + GFF)
UPLOADED_GENOMES_TTL_HOURS=0.5
# 清理线程扫描间隔(秒)
UPLOADED_GENOMES_CLEANUP_INTERVAL=300

# ===== 展示名(仅前端/IGV 标签;覆盖 index_stat 的 heads/biosample_order) =====
# 推理时模型输出头仍用 index_stat 里的 ckpt 匹配键,这里只改界面显示名
DISPLAY_HEADS=RNA-seq
DISPLAY_BIOSAMPLES=Leaf

# ===== API Key 鉴权(可选) =====
# 留空 = 不启用鉴权(本地直连/开发测试);配置后 /api/aigress/openai/rice-mut 与
#   /api/aigress/openai/rice-mut/snv 需带请求头:
#   Authorization: Bearer <DCS_API_KEY>
#   (也兼容 X-API-Key: <DCS_API_KEY>)
# 部署到 DCS 平台时由平台网关校验,此配置可留空
DCS_API_KEY=
