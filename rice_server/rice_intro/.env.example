# ===== 服务配置 =====
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5001
# 仅用于前端进程【服务端内部】调用后端 API 与 /backend/* 反向代理转发目标。
# 浏览器不再直接访问此地址（Plotly/静态资源统一走前端同源 /backend/* 代理），
# 因此用 127.0.0.1 最稳，不依赖服务器网卡 IP；若前后端分离部署才需改成远端地址。
BACKEND_API_URL=http://127.0.0.1:5001

# ===== 上传大小限制(单位 MB) =====
MAX_UPLOAD_MB=640

# ===== Python 解释器 =====
BACKEND_PYTHON_BIN=/root/miniconda3/envs/vllm/bin/python
FRONTEND_PYTHON_BIN=/root/miniconda3/envs/rice_reg/bin/python
# BACKEND_PYTHON_BIN=python
# FRONTEND_PYTHON_BIN=python

# ===== 模型路径 =====
# 基座模型（Mixtral-1B DNA LM，vocab=128）
BASE_MODEL_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/20.introgression_analysis/data/model/rice_1B_stage2_8k_hf
# 微调后的分类头 + LoRA 权重（checkpoint 目录，内含 model.safetensors）
CHECKPOINT_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/20.introgression_analysis/data/checkpoint/checkpoint-18700

# ===== 推理参数（与 20.introgression_analysis/configs/config.yaml 一致） =====
SHARE_HF_TOKEN=
MODEL_TORCH_DTYPE=float32
DEVICE=cuda:0
# 单次模型前向处理的序列数（覆盖 256k 窗口的 32 段 8k 序列）
INFERENCE_BATCH_SIZE=8
# 微调时使用 bf16/fp16 时开启；与训练 config.train 保持一致
MODEL_USE_BF16=false
MODEL_USE_FP16=true

# ===== LoRA 配置（与训练一致 r=16 alpha=32，q_proj/v_proj） =====
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.1
LORA_TARGET_MODULES=q_proj,v_proj

# ===== 投影头与分类头（与训练一致 projection.dims=[1024,512,128]，num_labels=2） =====
PROJ_DIMS=1024,512,128
NUM_LABELS=2
POOLING_STRATEGY=masked_mean
HEAD_DROPOUT=0.1
LAMBDA_CONTRASTIVE=0.1

# ===== 渗入分析参数（与 config.analysis 一致） =====
SEGMENT_SIZE=8000
WINDOW_SIZE=256000
WINDOW_STEP=64000
TOP_K=10
# 双阈值 [thr_jap, thr_ind]（与 config.integrate.thresholds 一致）
THRESHOLD_JAP=0.55519
THRESHOLD_IND=0.53473
# 单请求至多推理的 256k 窗口个数上限（MAX_NUMBER_256W）：
#   留空 / 0 / 负数 = 不限制（整条跑全部分辨窗口；窗口模式跑 1 个最大覆盖窗口）
#   正整数 N（如 3）= 未填 start 时只跑染色体前 N 个 256k 窗口；
#                      只填 start（未填 end）时始终只推 1 个窗口；
#                      start 与 end 都填时只跑与该区间覆盖度最大的 N 个 256k 窗口
MAX_NUMBER_256W=

# ===== 基因组配置 =====
# 格式: GENOME_<ID>_FASTA, GENOME_<ID>_FAI
# FAI 可省略（后端自动用 pyfaidx 建索引）
GENOME_YF47_FASTA=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/20.introgression_analysis/data/fasta_data/YF47_GWHBKAR00000000.genome.fasta.gz
GENOME_YF47_FAI=

# ===== 缓存目录 =====
BACKEND_UPLOADED_FASTA=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/rice_intro/cache/uploaded_fasta
BACKEND_PREDICTION_CACHE=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/rice_intro/cache/predictions
# 重启服务时是否自动清理预测缓存（true=启动即清空内存+磁盘缓存并重建；留空/其他=预热磁盘缓存）
CLEAR_CACHE_ON_STARTUP=true

# ===== 上传基因组 TTL 清理 =====
UPLOADED_GENOMES_TTL_HOURS=1.0
UPLOADED_GENOMES_CLEANUP_INTERVAL=300

# ===== DCS 适配层（backend/dcs_adapter.py 独立进程） =====
# 监听端口：DCS 平台注入的 PORT 优先，回退 BACKEND_PORT（DCS 部署约定 5001）
# 鉴权：留空 = 不启用；配置后 POST 推理需带
#   Authorization: Bearer <DCS_API_KEY>  (或 X-API-Key: <DCS_API_KEY>)
DCS_API_KEY=
# 计费倍数：prompt_tokens = 推理碱基数 × 倍数（默认 1）；completion_tokens = 窗口数 × 倍数
DCS_PROMPT_TOKEN_MULTIPLIER=1
DCS_COMPLETION_TOKEN_MULTIPLIER=1