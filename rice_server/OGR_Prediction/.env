# ===== 服务配置 =====
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=8000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
# 仅用于前端进程【服务端内部】调用后端 API 与 /backend/* 反向代理转发目标。
# 浏览器不再直接访问此地址（IGV/静态资源统一走前端同源 /backend/* 代理），
# 因此用 127.0.0.1 最稳，不依赖服务器网卡 IP；若前后端分离部署才需改成远端地址。
BACKEND_API_URL=http://127.0.0.1:8001

# ===== 上传大小限制(单位 MB) =====
MAX_UPLOAD_MB=640

# ===== Python 解释器 =====
# BACKEND_PYTHON_BIN=/root/miniconda3/envs/vllm/bin/python
# FRONTEND_PYTHON_BIN=/root/miniconda3/envs/rice_reg/bin/python
BACKEND_PYTHON_BIN=python
FRONTEND_PYTHON_BIN=python

# ===== 模型路径 =====
BASE_MODEL_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/model_data/rice_1B_stage2_8k_hf
CHECKPOINT_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/model_data/csq-5_model.safetensors
INDEX_STAT_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/model_data/index_stat.json

# ===== 推理参数 =====
USE_FLASH_ATTN=true
MODEL_TORCH_DTYPE=bfloat16
DEVICE=cuda:0
# 单次模型前向处理的序列数
INFERENCE_BATCH_SIZE=4
PROJ_DIM=1024
NUM_DOWNSAMPLES=4
BOTTLENECK_DIM=1536
MAX_SEQ_LEN=32768

# ===== 基因组配置 =====
# 格式: GENOME_<ID>_FASTA, GENOME_<ID>_FAI, GENOME_<ID>_GFF
GENOME_osa1_r7_FASTA=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/OGR/OGR_Prediction/builtin/osa1_r7.asm.ch.fa
GENOME_osa1_r7_FAI=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/OGR/OGR_Prediction/builtin/osa1_r7.asm.ch.fa.fai
GENOME_osa1_r7_GFF=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/OGR/OGR_Prediction/builtin/osa1_r7.all_models.gff3

# ===== 缓存模式 =====
# CACHE_MODE 只控制【懒加载 + 内容寻址缓存】:
# true  = 启用内容寻址预测缓存(相同窗口复用上次结果,跳过 GPU 推理) + 上传文件复制到 cache 目录
# false = 懒加载部署:不做内容寻址缓存(每次请求重跑推理) + 自定义基因组只按本机路径注册(零拷贝)
# 两种模式下预测中间 bigWig 一律写入 BACKEND_PREDICTION_CACHE,服务重启时自动清空该目录。
CACHE_MODE=false

# ===== 缓存目录 =====
# 上传基因组目录(字节上传的副本 / 外部 FASTA 的 .fai 软链接落盘位置)
BACKEND_UPLOADED_FASTA=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/OGR/OGR_Prediction/uploaded_fasta
BACKEND_UPLOADED_GENOMES=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/OGR/OGR_Prediction/uploaded_genomes
# 预测中间 bigWig 目录(两种模式都用它;服务重启时整个目录被清空重建)
BACKEND_PREDICTION_CACHE=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/OGR/OGR_Prediction/predictions
# 后台清理陈旧 bigWig 的扫描间隔(秒)与存活时长(秒)
PREDICTION_CACHE_CLEANUP_INTERVAL=600
PREDICTION_CACHE_TTL_SECONDS=1800

# ===== 上传基因组 TTL 清理 =====
# 超过该时长(小时)未使用的上传 custom genome 会被自动清理(FASTA + .fai + GFF)
UPLOADED_GENOMES_TTL_HOURS=0.5
# 清理线程扫描间隔(秒)
UPLOADED_GENOMES_CLEANUP_INTERVAL=300

# ===== 展示名(仅前端/IGV 标签;覆盖 index_stat 的 heads/biosample_order) =====
# 推理时模型输出头仍用 index_stat 里的 ckpt 匹配键,这里只改界面显示名
DISPLAY_HEADS=RNA-seq
DISPLAY_BIOSAMPLES=Leaf

# ===== API Key 鉴权(可选,仅后端校验用) =====
# 该变量只被后端进程读取用于**校验**请求头:
#   配置后 /api/aigress/openai/OGR-Prediction/* 需带 Authorization: Bearer <DCS_API_KEY>
#   (也兼容 X-API-Key: <DCS_API_KEY>),否则返回 401。
# 留空 = 后端不校验(本地直连/开发测试);部署到 DCS 平台时由平台网关校验,此配置可留空。
# ⚠️ 前端网页端的 API Key 由页面输入框(运行时)提供,不读此变量。
DCS_API_KEY=
