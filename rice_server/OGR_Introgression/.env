# ===== 服务配置 =====
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=5000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5001
# 仅用于前端进程【服务端内部】调用后端 API 与 /backend/* 反向代理转发目标。
BACKEND_API_URL=http://127.0.0.1:5001

# ===== 上传大小限制(单位 MB) =====
MAX_UPLOAD_MB=640

# ===== Python 解释器 =====
# BACKEND_PYTHON_BIN=/root/miniconda3/envs/vllm/bin/python
# FRONTEND_PYTHON_BIN=/root/miniconda3/envs/rice_reg/bin/python
BACKEND_PYTHON_BIN=python
FRONTEND_PYTHON_BIN=python

# ===== 模型路径 =====
BASE_MODEL_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/OGR_Prediction/rice_1B_stage2_8k_hf
CHECKPOINT_PATH=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/OGR_Introgression/model.safetensors

# ===== 推理参数（与 20.introgression_analysis/configs/config.yaml 一致） =====
SHARE_HF_TOKEN=
# 模型权重保持 fp32（checkpoint 加载精度），前向用 torch.autocast fp16
# （数值与离线 Trainer 一致且省显存；不要 model.to(fp16)）。
MODEL_TORCH_DTYPE=float32
# GPU 0 被其他进程占用较多，使用 GPU 0（A40 45GB 空闲）
DEVICE=cuda:0
# 单次模型前向处理的序列数（覆盖 256k 窗口的 32 段 8k 序列）
INFERENCE_BATCH_SIZE=8
# 与离线 config 一致：fp16=true
MODEL_USE_BF16=false
MODEL_USE_FP16=true

# ===== LoRA 配置（与训练一致 r=16 alpha=32，q_proj/v_proj） =====
LORA_R=16
LORA_ALPHA=32
LORA_DROPOUT=0.1
LORA_TARGET_MODULES=q_proj,v_proj

# ===== 投影头与分类头（与训练一致 projection.dims=[1024,512,128]，num_labels=2） =====
PROJ_DIMS=1024,512,128
NUM_LABELS=2
POOLING_STRATEGY=masked_mean
HEAD_DROPOUT=0.1
LAMBDA_CONTRASTIVE=0.1

# ===== 渗入分析参数（与 config.analysis 一致） =====
SEGMENT_SIZE=8000
WINDOW_SIZE=256000
WINDOW_STEP=64000
TOP_K=10
# 双阈值 [thr_jap, thr_ind]（与 config.integrate.thresholds 一致）
THRESHOLD_JAP=0.55519
THRESHOLD_IND=0.53473
# 单请求至多推理的 256k 窗口个数上限；留空=不限制，正整数 N=至多 N 个窗口
# 窗口模式（给了 start）：只填 start 恒 1 窗（忽略本上限）；start+end 重叠滑窗
# 生成后截断前 N 窗。整条模式（start/end 空）：取标准网格前 N 窗。
MAX_NUMBER_256W=16

# ===== 基因组配置 =====
GENOME_YF47_FASTA=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/source/OGR_Introgression/genome/YF47_ChrOnly.fasta
GENOME_YF47_FAI=

# ===== 缓存目录 =====
BACKEND_UPLOADED_FASTA=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/OGR_Introgression/cache/uploaded_fasta
BACKEND_PREDICTION_CACHE=/mnt/rice/default/Workspace/yangdong/ai4research/rice_server/OGR_Introgression/cache/predictions

# ===== 缓存模式 =====
# CACHE_MODE 只控制【懒加载 + 内容寻址缓存】:
# true  = 启用内容寻址预测缓存(磁盘+内存,相同窗口复用结果跳过 GPU 推理)
# false = 懒加载部署:不做内容寻址缓存(每次请求重跑 GPU) + 自定义基因组只按本机路径
#         懒注册(managed=False,零拷贝,TTL 只移注册表不删外部文件);/uploadFasta 支持 path 字段
# 两种模式下服务重启都会自动清空预测缓存目录（内存 + 磁盘）。
CACHE_MODE=false

# ===== 上传基因组 TTL 清理 =====
UPLOADED_GENOMES_TTL_HOURS=1.0
UPLOADED_GENOMES_CLEANUP_INTERVAL=300

# ===== DCS API（并入统一后端，与网页路由同一进程/端口） =====
# 网页端与纯 API 调用共用同一进程（backend/rice_introgression/main.py）；
# 监听端口：DCS 平台注入的 PORT 优先，回退 BACKEND_PORT（DCS 部署约定 5001）。
# 鉴权：留空 = 不启用；配置后 DCS 子路径 POST 需带
#   Authorization: Bearer <DCS_API_KEY>  (或 X-API-Key: <DCS_API_KEY>)
DCS_API_KEY=
# 计费倍数：prompt_tokens = 推理碱基数 × 倍数（默认 1）；completion_tokens = 窗口数 × 倍数
DCS_PROMPT_TOKEN_MULTIPLIER=1
DCS_COMPLETION_TOKEN_MULTIPLIER=1